---
import { LOCATIONS_CONFIG } from '../lib/branches';
import '../styles/global.css';

const locationsForClient = Object.fromEntries(
  Object.entries(LOCATIONS_CONFIG).map(([id, cfg]) => [
    id,
    {
      id: cfg.id,
      name: cfg.name,
      appsScriptUrl: cfg.appsScriptUrl,
      spreadsheetId: cfg.spreadsheetId
    }
  ])
);

const baseUrl = import.meta.env.BASE_URL || '/';
const notFoundPath = `${baseUrl}404`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Carta Digital</title>
  <meta name="description" content="Carta digital cargada desde Google Sheets." />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍽️</text></svg>">
  <style>
    body.is-loading {
      visibility: hidden;
    }
  </style>
</head>
<body class="is-loading">
  <div class="container">
    <header>
      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
        <div class="branch-logo" style="display: flex; align-items: center; gap: 0.5rem; background: var(--card-bg); padding: 0.4rem 0.8rem; font-size: 0.85rem; font-weight: 500;">
          <img id="branch-logo" src="" alt="">
        </div>

        <button id="theme-toggle" class="btn btn-secondary" aria-label="Cambiar tema" style="padding: 0.5rem; border-radius: 50%; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;">
          <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-sun"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
          <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-moon" style="display: none;"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        </button>
      </div>

      <h1 id="restaurant-name">Carta Digital</h1>
      <p class="subtitle" id="branch-subtitle">Cargando...</p>
    </header>

    <section class="search-filter-container" aria-label="Búsqueda y filtros">
      <div class="search-box">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="menu-search" placeholder="Buscar por plato o ingrediente..." autocomplete="off" />
      </div>

      <div class="categories-wrapper" role="tablist" aria-label="Categorías de platos" id="categories-tabs">
        <button class="category-btn active" role="tab" aria-selected="true" data-category="all" id="cat-all">✨ Todos</button>
      </div>
    </section>

    <section class="recommended-section" id="recommended-wrapper" style="display: none;">
      <h2 class="recommended-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-color);"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon></svg>
        Recomendados del Chef
      </h2>
      <div class="recommended-grid" id="recommended-grid"></div>
    </section>

    <main id="menu-container"></main>

    <div id="no-results" style="display: none; text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
      <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 1rem; opacity: 0.5;"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.3-4.3"></path><path d="M8 11h6"></path></svg>
      <p style="font-weight: 500;">No encontramos platos que coincidan con tu búsqueda</p>
      <p style="font-size: 0.85rem; margin-top: 0.25rem;">Intenta con otros ingredientes o categorías.</p>
    </div>

    <footer style="margin-top: 5rem; padding-top: 2rem; border-top: 1px solid var(--border-color); text-align: center; color: var(--text-muted); font-size: 0.85rem;">
      <p id="footer-address" style="margin-top: 0.25rem;">📍 no disponible</p>
      <p id="footer-hours" style="margin-top: 0.25rem;">🕒 no disponible</p>
      <p style="margin-top: 0.75rem; display: none;" id="footer-whatsapp-wrap">
        <a id="footer-whatsapp" target="_blank" rel="noopener noreferrer" style="display: inline-flex; align-items: center; gap: 0.4rem; background: #25D366; color: white; padding: 0.5rem 1rem; border-radius: var(--radius-sm); font-weight: 600; text-decoration: none; margin-top: 0.25rem;">💬 Contactar por WhatsApp</a>
      </p>
      <p style="margin-top: 1.5rem; font-size: 0.75rem;">© {new Date().getFullYear()} Carta Digital • Todos los derechos reservados</p>
    </footer>
  </div>

  <script is:inline define:vars={{ locationsForClient, notFoundPath }}>
    (async function loadBranchFromUrl() {
      const redirectTo404 = () => window.location.replace(notFoundPath);
      const localId = (new URLSearchParams(window.location.search).get('local') || '').trim().toLowerCase();

      console.log('[Branch] local resolution', {
        localId,
        hasConfig: !!locationsForClient[localId],
        hasUrl: !!locationsForClient[localId]?.appsScriptUrl
      });

      if (!localId) {
        redirectTo404();
        return;
      }

      const branchConfig = locationsForClient[localId];
      if (!branchConfig || !branchConfig.appsScriptUrl) {
        redirectTo404();
        return;
      }

      try {
        const data = await fetchBranchData(branchConfig.appsScriptUrl, redirectTo404);
        if (!data) {
          redirectTo404();
          return;
        }

        console.log('[Branch] api payload', {
          success: data.success,
          hasProfile: !!data.profile,
          profileKeys: Object.keys(data.profile || {}),
          categoriesCount: Array.isArray(data.categories) ? data.categories.length : 0,
          itemsCount: Array.isArray(data.items) ? data.items.length : 0
        });

        renderBranch(data, branchConfig, localId);
        document.body.classList.remove('is-loading');
      } catch (error) {
        console.error('[Branch] Error al cargar sucursal dinámica:', error);
        redirectTo404();
      }
    })();

    async function fetchBranchData(appsScriptUrl, redirectTo404) {
      const response = await fetch(appsScriptUrl);
      if (!response.ok) {
        redirectTo404();
        return null;
      }

      const rawText = await response.text();
      console.log('[Branch] raw api response', {
        status: response.status,
        contentType: response.headers.get('content-type'),
        length: rawText.length,
        preview: rawText.slice(0, 600)
      });

      let data;
      try {
        data = JSON.parse(rawText);
      } catch (parseError) {
        console.error('[Branch] api json parse error', parseError, rawText.slice(0, 600));
        redirectTo404();
        return null;
      }

      if (!data || !data.success) {
        redirectTo404();
        return null;
      }

      return data;
    }

    function renderBranch(data, branchConfig, localId) {
      const profile = data.profile || {};
      const categories = Array.isArray(data.categories) ? data.categories : [];
      const items = Array.isArray(data.items) ? data.items : [];
      const branchName = profile.name || 'no disponible';
      const recommendedItems = items.filter(item => item.isRecommended && item.isAvailable);

      document.getElementById('restaurant-name')?.replaceChildren(document.createTextNode(branchName));
      document.getElementById('branch-logo')?.setAttribute('src', profile.logoUrl || '');
      document.getElementById('branch-subtitle')?.replaceChildren(document.createTextNode(profile.subtitle || 'no disponible'));
      document.getElementById('footer-name')?.replaceChildren(document.createTextNode(branchName));
      document.getElementById('footer-address')?.replaceChildren(document.createTextNode(`📍 ${profile.address || 'no disponible'}`));
      document.getElementById('footer-hours')?.replaceChildren(document.createTextNode(`🕒 ${profile.openingHours || 'no disponible'}`));

      const whatsapp = String(profile.whatsapp || '').trim();
      const whatsappWrap = document.getElementById('footer-whatsapp-wrap');
      const whatsappLink = document.getElementById('footer-whatsapp');
      if (whatsappWrap && whatsappLink) {
        if (whatsapp) {
          whatsappLink.setAttribute('href', `https://wa.me/${whatsapp.replace(/[^0-9]/g, '')}?text=${encodeURIComponent('Hola! Quisiera hacer una consulta/pedido.')}`);
          whatsappWrap.style.display = 'block';
        } else {
          whatsappWrap.style.display = 'none';
        }
      }

      const adminLink = document.getElementById('admin-link');
      if (adminLink) {
        adminLink.setAttribute('href', `/gestionar-carta?local=${encodeURIComponent(localId)}`);
      }

      document.title = `${branchName} | Carta Digital`;
      document.querySelector('meta[name="description"]')?.setAttribute('content', `Explora el menú de ${branchName}.`);

      if (profile.accentColor) {
        document.documentElement.style.setProperty('--accent-color', profile.accentColor);
      } else {
        document.documentElement.style.removeProperty('--accent-color');
      }

      console.log('[Branch] render complete', {
        branchName,
        profileKeys: Object.keys(profile),
        missingProfileFields: Object.entries(profile)
          .filter(([, value]) => !String(value || '').trim())
          .map(([key]) => key)
      });

      renderRecommendedSection(recommendedItems);
      renderCategoriesAndMenu(categories, items);
      bindCategoryFilters();
      bindAccordion();
      bindSearch();
    }

    function renderRecommendedSection(recommendedItems) {
      const wrapper = document.getElementById('recommended-wrapper');
      const grid = document.getElementById('recommended-grid');
      if (!wrapper || !grid) return;

      if (!recommendedItems.length) {
        wrapper.style.display = 'none';
        grid.innerHTML = '';
        return;
      }

      grid.innerHTML = recommendedItems.map(item => `
        <div class="recommended-card" data-item-id="${escapeHtml(item.id)}" role="button" aria-haspopup="true">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.5rem;">
            <h3 style="font-size: 1rem; font-weight: 600; line-height: 1.2;">${escapeHtml(item.name || 'no disponible')}</h3>
            <span style="font-weight: 700; color: var(--accent-color);">${formatCurrency(item.price)}</span>
          </div>
          <p style="font-size: 0.8rem; color: var(--text-muted); line-height: 1.3; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
            ${escapeHtml(item.description || 'no disponible')}
          </p>
        </div>
      `).join('');

      wrapper.style.display = 'block';
    }

    function renderCategoriesAndMenu(categories, items) {
      const tabsContainer = document.getElementById('categories-tabs');
      const menuContainer = document.getElementById('menu-container');
      if (!tabsContainer || !menuContainer) return;

      tabsContainer.innerHTML = `<button class="category-btn active" role="tab" aria-selected="true" data-category="all" id="cat-all">✨ Todos</button>`;
      menuContainer.innerHTML = '';

      const groupedItems = {};
      items.forEach(item => {
        const categoryId = String(item.categoryId || '').trim().toLowerCase();
        if (!groupedItems[categoryId]) groupedItems[categoryId] = [];
        groupedItems[categoryId].push(item);
      });

      categories.forEach(category => {
        const categoryId = String(category.id || '').trim().toLowerCase();
        const categoryItems = groupedItems[categoryId] || [];

        const button = document.createElement('button');
        button.className = 'category-btn';
        button.setAttribute('role', 'tab');
        button.setAttribute('aria-selected', 'false');
        button.setAttribute('data-category', categoryId);
        button.id = `cat-${categoryId}`;
        button.textContent = `${category.icon || '•'} ${category.name || 'no disponible'}`;
        tabsContainer.appendChild(button);

        if (!categoryItems.length) {
          return;
        }

        const group = document.createElement('div');
        group.className = 'menu-group';
        group.setAttribute('data-category-group', categoryId);
        group.innerHTML = `<h2 class="menu-group-title">${escapeHtml(category.name || 'no disponible')}</h2><div class="menu-list" id="list-${categoryId}"></div>`;
        const list = group.querySelector(`#list-${CSS.escape(categoryId)}`);

        categoryItems.forEach(item => {
          const itemName = String(item.name || 'no disponible');
          const itemDescription = String(item.description || 'no disponible');
          const isAvailable = item.isAvailable !== false;
          const div = document.createElement('div');
          div.className = `menu-item${isAvailable ? '' : ' unavailable'}`;
          div.setAttribute('data-item-name', itemName.toLowerCase());
          div.setAttribute('data-item-desc', itemDescription.toLowerCase());
          div.setAttribute('data-item-category', categoryId);
          div.setAttribute('data-item-id', String(item.id || ''));
          div.innerHTML = `
            <div class="menu-item-header" role="button" aria-expanded="false">
              <div class="menu-item-info">
                <div class="menu-item-title-row">
                  <h3 class="menu-item-title">${escapeHtml(itemName)}</h3>
                  ${item.isRecommended && isAvailable ? '<span class="badge badge-recommended">Recomendado</span>' : ''}
                  ${!isAvailable ? '<span class="badge badge-unavailable">Sin Stock</span>' : ''}
                </div>
              </div>
              <div style="display: flex; align-items: center; gap: 0.75rem;">
                <span class="menu-item-price">${formatCurrency(item.price)}</span>
                <svg class="arrow-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </div>
            </div>
            <div class="menu-item-body">
              <div class="menu-item-content">
                <div class="menu-item-detail">
                  <div class="menu-item-description"><p>${escapeHtml(itemDescription)}</p></div>
                  ${item.imageUrl ? `<img src="${escapeHtml(item.imageUrl)}" alt="${escapeHtml(itemName)}" class="menu-item-image" loading="lazy" onerror="this.style.display='none'">` : ''}
                </div>
              </div>
            </div>
          `;
          list?.appendChild(div);
        });

        menuContainer.appendChild(group);
      });

      filterMenu();
    }

    function bindSearch() {
      const searchInput = document.getElementById('menu-search');
      if (!searchInput) return;
      searchInput.addEventListener('input', event => {
        searchQuery = String(event.target?.value || '').toLowerCase().trim();
        filterMenu();
      });
    }

    function bindCategoryFilters() {
      const buttons = document.querySelectorAll('.category-btn');
      buttons.forEach(button => {
        button.addEventListener('click', () => {
          buttons.forEach(current => {
            current.classList.remove('active');
            current.setAttribute('aria-selected', 'false');
          });
          button.classList.add('active');
          button.setAttribute('aria-selected', 'true');
          currentFilterCategory = String(button.getAttribute('data-category') || 'all');
          filterMenu();
        });
      });
    }

    function bindAccordion() {
      const menuItems = document.querySelectorAll('.menu-item');
      menuItems.forEach(item => {
        const header = item.querySelector('.menu-item-header');
        if (!header) return;
        header.onclick = () => {
          const wasExpanded = item.classList.contains('expanded');
          menuItems.forEach(otherItem => {
            if (otherItem !== item && otherItem.classList.contains('expanded')) {
              otherItem.classList.remove('expanded');
              otherItem.querySelector('.menu-item-header')?.setAttribute('aria-expanded', 'false');
            }
          });
          item.classList.toggle('expanded', !wasExpanded);
          header.setAttribute('aria-expanded', !wasExpanded ? 'true' : 'false');
        };
      });
    }

    function filterMenu() {
      let totalVisibleItems = 0;
      const searchValue = searchQuery;
      const isFiltering = searchValue.length > 0 || currentFilterCategory !== 'all';
      const recommendedWrapper = document.getElementById('recommended-wrapper');
      if (recommendedWrapper) {
        recommendedWrapper.style.display = isFiltering ? 'none' : 'block';
      }

      document.querySelectorAll('.menu-group').forEach(group => {
        let visibleItemsInGroup = 0;
        group.querySelectorAll('.menu-item').forEach(item => {
          const itemName = item.getAttribute('data-item-name') || '';
          const itemDesc = item.getAttribute('data-item-desc') || '';
          const itemCategory = item.getAttribute('data-item-category');
          const matchesCategory = currentFilterCategory === 'all' || itemCategory === currentFilterCategory;
          const matchesSearch = searchValue === '' || itemName.includes(searchValue) || itemDesc.includes(searchValue);

          if (matchesCategory && matchesSearch) {
            item.style.display = 'block';
            visibleItemsInGroup += 1;
            totalVisibleItems += 1;
          } else {
            item.style.display = 'none';
            item.classList.remove('expanded');
            item.querySelector('.menu-item-header')?.setAttribute('aria-expanded', 'false');
          }
        });
        group.style.display = visibleItemsInGroup > 0 ? 'block' : 'none';
      });

      const noResults = document.getElementById('no-results');
      if (noResults) {
        noResults.style.display = totalVisibleItems === 0 ? 'block' : 'none';
      }
    }

    function formatCurrency(value) {
      const number = Number(value);
      if (!Number.isFinite(number) || number <= 0) {
        return 'no disponible';
      }
      return `$${number.toLocaleString('es-AR')}`;
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    const themeToggleBtn = document.getElementById('theme-toggle');
    const sunIcon = document.getElementById('sun-icon');
    const moonIcon = document.getElementById('moon-icon');
    const savedTheme = localStorage.getItem('theme');
    const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    const initialDark = savedTheme === 'dark' || (!savedTheme && systemPrefersDark);

    if (initialDark) {
      document.documentElement.classList.add('dark');
      document.body.style.setProperty('color-scheme', 'dark');
      sunIcon.style.display = 'inline-block';
      moonIcon.style.display = 'none';
    } else {
      document.documentElement.classList.remove('dark');
      document.body.style.setProperty('color-scheme', 'light');
      sunIcon.style.display = 'none';
      moonIcon.style.display = 'inline-block';
    }

    themeToggleBtn?.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      document.body.style.setProperty('color-scheme', isDark ? 'dark' : 'light');
      sunIcon.style.display = isDark ? 'inline-block' : 'none';
      moonIcon.style.display = isDark ? 'none' : 'inline-block';
    });

    let currentFilterCategory = 'all';
    let searchQuery = '';
  </script>
</body>
</html>
