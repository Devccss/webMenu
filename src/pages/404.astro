---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Página no encontrada | Carta Digital</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>🍽️</text></svg>">
  <style>
    .not-found-page {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 2rem;
      gap: 1.5rem;
    }

    .not-found-icon {
      font-size: 5rem;
      animation: float 3s ease-in-out infinite;
      line-height: 1;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0px); }
      50% { transform: translateY(-12px); }
    }

    .not-found-code {
      font-size: 7rem;
      font-weight: 900;
      line-height: 1;
      background: linear-gradient(135deg, var(--accent-color, #e63946), #ff6b6b);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      letter-spacing: -2px;
    }

    .not-found-title {
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--text-primary);
      margin: 0;
    }

    .not-found-desc {
      font-size: 1rem;
      color: var(--text-secondary);
      max-width: 380px;
      line-height: 1.6;
    }

    .not-found-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 1.5rem 2rem;
      max-width: 420px;
      width: 100%;
    }

    .not-found-card p {
      font-size: 0.9rem;
      color: var(--text-secondary);
      margin: 0 0 0.5rem;
    }

    .not-found-card code {
      display: inline-block;
      background: var(--bg-tertiary);
      color: var(--accent-color);
      padding: 0.2rem 0.6rem;
      border-radius: 0.25rem;
      font-family: monospace;
      font-size: 0.85rem;
    }

    .theme-btn-404 {
      position: fixed;
      top: 1rem;
      right: 1rem;
    }
  </style>
</head>
<body>
  <button id="theme-toggle" class="btn btn-secondary theme-btn-404" aria-label="Cambiar tema" style="padding: 0.5rem; border-radius: 50%; width: 40px; height: 40px; display: inline-flex; align-items: center; justify-content: center;">
    <svg id="sun-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
    <svg id="moon-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;"><path d="M12 3a6 6 0 0 0 9 9 9 0 1 1-9-9Z"/></svg>
  </button>

  <div class="not-found-page">
    <div class="not-found-icon">🍽️</div>
    <div class="not-found-code">404</div>
    <h1 class="not-found-title">Local no encontrado</h1>
    <p class="not-found-desc">
      El local que buscás no existe o el enlace que usaste no es válido. Verificá que la URL sea correcta.
    </p>

    <div class="not-found-card">
      <p>El enlace correcto tiene el formato:</p>
      <code>tudominio.com/?local=<strong>nombre-del-local</strong></code>
    </div>
  </div>

  <script is:inline>
    // Theme
    const saved = localStorage.getItem('theme');
    if (saved === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
    const btn = document.getElementById('theme-toggle');
    const sun = document.getElementById('sun-icon');
    const moon = document.getElementById('moon-icon');
    function updateIcons() {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      sun.style.display = isDark ? 'none' : 'block';
      moon.style.display = isDark ? 'block' : 'none';
    }
    updateIcons();
    btn?.addEventListener('click', () => {
      const isDark = document.documentElement.getAttribute('data-theme') === 'dark';
      document.documentElement.setAttribute('data-theme', isDark ? 'light' : 'dark');
      localStorage.setItem('theme', isDark ? 'light' : 'dark');
      updateIcons();
    });
  </script>
</body>
</html>
